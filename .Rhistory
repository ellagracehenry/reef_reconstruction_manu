# geom_vline(xintercept = mean(per_frame$hit_rate[per_frame$subject == "Surgeonfish"]), linetype = "dashed", color = scales::hue_pal()(2)[2]) +
labs(x = "Hit Rate", y = "Density") +
theme_classic(base_size = 14) +
theme(legend.position = "none")
