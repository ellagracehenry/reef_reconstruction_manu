View(per_frame)
full_data$hit_rate <- as.numeric(full_data$hit_rate)
test <- full_data %>%
filter(hit_rate == 100)
hri_data_f_height_f <- full_data %>%
select(ObsID, hit_rate, miss_rate, frame.x, subject, site, starts_with("height_bin_")) %>%
mutate(
hit_rate = as.numeric(hit_rate),
across(starts_with("height_bin_"), ~ as.numeric(as.character(.x))),
sum_bins = rowSums(across(starts_with("height_bin_")), na.rm = TRUE),
across(starts_with("height_bin_"),
~ .x * hit_rate * 50000,
.names = "ct_{.col}")
)
hri_data_f_height_f_long <- hri_data_f_height_f %>%
select(-starts_with("height_bin_"), -sum_bins, site) %>%
pivot_longer(
cols = starts_with("ct_height_bin_"),
names_to = "Bins", values_to = "Counts",
names_prefix = "ct_height_bin_"
) %>%
# "0_00_0_04m" -> lower = 0.00, upper = 0.04
extract(Bins, into = c("lower", "upper"),
regex = "^(\\d+_\\d+)_(\\d+_\\d+)m$", remove = FALSE) %>%
mutate(
across(c(lower, upper), ~ as.numeric(sub("_", ".", .x))),
Bins_center = (lower + upper) / 2,
Bins_num    = dense_rank(lower),
Counts      = round(Counts, 0),
Proportions = Counts / ((hit_rate / 100) * 50000)
)
#Distances
hri_data_f_distance_f <- full_data %>%
select(ObsID, hit_rate, miss_rate, frame.x, subject, site, starts_with("distance_bin_")) %>%
mutate(
hit_rate = as.numeric(hit_rate),
across(starts_with("distance_bin_"), ~ as.numeric(as.character(.x))),
sum_bins = rowSums(across(starts_with("distance_bin_")), na.rm = TRUE),
across(starts_with("distance_bin_"),
~ .x * (hit_rate / 100) * 50000,
.names = "ct_{.col}")
)
hri_data_f_distance_f_long <- hri_data_f_distance_f %>%
select(-starts_with("distance_bin_"), site, -sum_bins) %>%
pivot_longer(
cols = starts_with("ct_distance_bin_"),
names_to = "Bins", values_to = "Counts",
names_prefix = "ct_distance_bin_"
) %>%
extract(Bins, into = c("lower", "upper"),
regex = "^(\\d+_\\d+)_(\\d+_\\d+)m$", remove = FALSE) %>%
mutate(
across(c(lower, upper), ~ as.numeric(sub("_", ".", .x))),
Bins_center = (lower + upper) / 2,
Bins_num    = dense_rank(lower),
Counts      = round(Counts, 0),
Proportions = Counts / ((hit_rate / 100) * 50000)
)
#Hit rate
per_frame <- hri_data_f_distance_f_long %>%
group_by(site, ObsID, frame.x) %>%
reframe(hit_rate = first(hit_rate), subject = first(subject)) %>%
mutate(frame.x = as.numeric(frame.x), ObsID = as.factor(ObsID), hit_rate = hit_rate/100) %>%
filter(!is.na(hit_rate))
hit.rates <- ggplot(data = per_frame) +
geom_density(aes(x = hit_rate, color = as.factor(subject), group = ObsID), fill = NA, alpha = 0.1) +
