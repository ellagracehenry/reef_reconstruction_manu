read_and_clean <- function(f) {
  df <- readr::read_csv(f, show_col_types = FALSE, col_types = readr::cols(.default = "c")) %>%
    janitor::clean_names() %>%
    dplyr::mutate(
      source_file = basename(f),
      n = dplyr::row_number()
    )
}


