#MVT_ERROR MANIP
setwd("/Users/ellag/Desktop/PhD/academic_projects/3d_reconstruction/data/error/mvt_error")
csv_files <- list.files(pattern = "\\.csv$")

mvt_data <- lapply(csv_files, read_and_clean) %>% bind_rows()

mvt_data$trial_ID <- as.factor(as.numeric(as.factor(mvt_data$source_file)))

#ERROR FIG 4: CAMERA RECONSTRUCTION ERROR ABSOLUTE MEDIAN PER TRACK
mvt_data$source_file <- as.factor(mvt_data$source_file)
mvt_data$reconstruction_error <- abs(as.numeric(mvt_data$reconstruction_error))

e4 <- mvt_data %>%
  group_by(source_file) %>%
  summarise(abs_med_recons_err = median(reconstruction_error)) %>%
  ggplot(aes(x=abs_med_recons_err)) +
  geom_histogram(fill = "#56B4E9", color = "#FFFFFF", binwidth = 0.001) +
  labs(x = "Absolute median reconstruction error (m)", y = "Frequency") +
  theme_classic(base_size = 40)

ggsave("/Users/ellag/Desktop/PhD/academic_projects/3d_reconstruction/paper/figures/e4_med_track_reconstruction_error.png", plot = e4, width = 10, height = 10)

