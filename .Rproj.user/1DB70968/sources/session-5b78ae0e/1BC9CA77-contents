
# Prediction grid
newd <- expand.grid(
  hri_z = seq(
    min(stripped_data$hri_z, na.rm = TRUE),
    max(stripped_data$hri_z, na.rm = TRUE),
    length.out = 100
  ),
  social_state = c("Asocial", "Social"),
  subject = c("Parrotfish", "Surgeonfish")
)

# Match factor levels
newd$social_state <- factor(
  newd$social_state,
  levels = levels(stripped_data$social_state)
)

newd$subject <- factor(
  newd$subject,
  levels = unique(stripped_data$subject)
)

# Posterior predictions
pmu <- posterior_epred(
  activity_mod,
  newdata = newd,
  re_formula = NA
)

# There are 4 combinations:
# 1-100   = Asocial + Parrotfish
# 101-200 = Social + Parrotfish
# 201-300 = Asocial + Surgeonfish
# 301-400 = Social + Surgeonfish

# Average across species, separately for each social state
pmu_asocial <- (
  pmu[, 1:100] +
    pmu[, 201:300]
) / 2

pmu_social <- (
  pmu[, 101:200] +
    pmu[, 301:400]
) / 2

# Combine the averaged predictions
pmu_avg <- cbind(
  pmu_asocial,
  pmu_social
)

# Posterior means
mnmu <- colMeans(pmu_avg)

# 95% credible intervals
lower <- apply(
  pmu_avg,
  2,
  quantile,
  probs = 0.025
)

upper <- apply(
  pmu_avg,
  2,
  quantile,
  probs = 0.975
)

# Prediction data for plotting
preds <- data.frame(
  hri_z = rep(
    seq(
      min(stripped_data$hri_z, na.rm = TRUE),
      max(stripped_data$hri_z, na.rm = TRUE),
      length.out = 100
    ),
    2
  ),
  social_state = factor(
    rep(c("Asocial", "Social"), each = 100),
    levels = levels(stripped_data$social_state)
  ),
  estimate = mnmu,
  lower = lower,
  upper = upper
)

# Plot
ggplot() +
  
  geom_jitter(
    data = stripped_data,
    aes(
      x = hri_z,
      y = activity_state_num
    ),
    alpha = 0.15,
    size = 1,
    height = 0.02,
    width = 0.01
  ) +
  
  geom_ribbon(
    data = preds,
    aes(
      x = hri_z,
      ymin = lower,
      ymax = upper,
      fill = social_state
    ),
    alpha = 0.2
  ) +
  
  geom_line(
    data = preds,
    aes(
      x = hri_z,
      y = estimate,
      colour = social_state
    ),
    linewidth = 1.2
  ) +
  
  labs(
    x = "HRI",
    y = "Probability of foraging",
    colour = "Social state",
    fill = "Social state"
  ) +
  
  theme_bw()

